  .flow-record-tools { grid-template-columns: 1fr; }
  .flow-month-nav { grid-template-columns: 44px minmax(0, 1fr) 44px; }
  .action-feedback { bottom: max(10px, env(safe-area-inset-bottom)); grid-template-columns: minmax(0, 1fr) auto 34px; }
  .module-page-mode .app { width: calc(100% - 18px); }
  .module-page-mode .module-page-header { top: 6px; min-height: 0; }
  .subpage-context-bar { min-height: 0; padding: 13px 14px; }
  .module-page-mode .flow-stat,
