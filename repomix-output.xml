}

.dashboard-strip-item small {
  display: block;
  color: var(--muted);
  font-family: var(--font-sans-zh);
  font-size: 11px;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dashboard-strip-item .dashboard-strip-title {
  grid-area: 1 / 1;
  color: #2F2921;
  font-family: var(--font-sans-zh);
  font-size: 15px;
  font-weight: 650;
  letter-spacing: 0;
  line-height: 1.2;
  justify-self: start;
  align-self: start;
  text-align: left;
}

.dashboard-strip-item .dashboard-strip-value {
  display: block;
  margin: 0;
  color: var(--text);
  font-family: var(--font-number);
  font-size: clamp(18px, 1.1vw, 22px);
  font-weight: 700;
  letter-spacing: -.02em;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dashboard-strip-item .dashboard-strip-desc {
  font-size: 11px;
  line-height: 1.2;
}

.dashboard-strip-visual {
  min-width: 0;
}

.dashboard-strip-progress {
  display: grid;
  gap: 3px;
  margin-top: 0;
  align-self: center;
}

.dashboard-strip-progress b {
  display: block;
  height: 6px;
  border-radius: 999px;
  background:
    linear-gradient(90deg, rgba(184,136,67,.78) var(--strip-progress), rgba(201,166,107,.10) 0),
    rgba(255,253,248,.24);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.46);
}

.dashboard-strip-progress p {
  margin: 0;
  display: flex;
  justify-content: space-between;
  gap: 8px;
}

.dashboard-strip-progress p span {
  min-width: 0;
  color: var(--muted);
  font-family: var(--font-sans-zh);
  font-size: 11px;
  font-weight: 500;
  line-height: 1.35;
}

.dashboard-strip-cash .dashboard-strip-progress {
  width: 78%;
}

.dashboard-strip-cash .dashboard-strip-progress p span {
  font-size: 10px;
}

.dashboard-strip-donut-wrap {
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr);
  gap: 8px;
  align-items: center;
  margin-top: 0;
  align-self: center;
}

.dashboard-strip-structure .dashboard-strip-value,
.dashboard-strip-allocation .dashboard-strip-value {
  font-size: 16px;
}

.dashboard-strip-donut {
  width: 46px;
  aspect-ratio: 1 / 1;
  border-radius: 999px;
  background:
    radial-gradient(circle, rgba(255,253,248,.92) 0 56%, transparent 57%),
    radial-gradient(circle at 34% 24%, rgba(255,255,255,.62), transparent 28%),
    conic-gradient(var(--strip-donut));
  box-shadow:
    inset 0 0 0 1px rgba(201,166,107,.12),
    0 3px 8px rgba(133,100,52,.030);
}

.dashboard-strip-mini-list {
  min-width: 0;
  display: grid;
  gap: 2px;
}

.dashboard-strip-item .dashboard-strip-mini-list span {
  display: flex;
  align-items: center;
  gap: 4px;
  color: rgba(112,99,78,.78);
  font-family: var(--font-sans-zh);
  font-size: 10px;
  line-height: 1.2;
  font-weight: 500;
}

.dashboard-strip-item .dashboard-strip-mini-list i {
  width: 5px;
  height: 5px;
