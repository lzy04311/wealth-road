.dashboard-cockpit-page {
  --dashboard-core-lift: 50px;
  --dashboard-strip-rise: var(--dashboard-core-lift);
  --font-serif-zh: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", serif;
  --font-sans-zh: "PingFang SC", "Microsoft YaHei", "Noto Sans SC", "Source Han Sans SC", sans-serif;
  --font-number: "DIN Alternate", "DIN Condensed", "Avenir Next", "Inter", "SF Pro Display", "Segoe UI", sans-serif;
  --glass-cream: rgba(255, 253, 248, .58);
  --glass-cream-soft: rgba(250, 244, 232, .34);
  --glass-line: rgba(232, 205, 156, .34);
  --glass-line-bright: rgba(255, 255, 255, .66);
  --warm-ink: #2F2921;
  --deep-gold-brown: #74522A;
  --amber-glow: rgba(221, 181, 109, .20);
  position: relative;
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto auto;
  gap: 8px;
  padding: 4px 4px 6px;
  border-radius: 0;
  background:
    radial-gradient(ellipse at 50% 42%, rgba(224,188,119,.18), transparent 36rem),
    radial-gradient(ellipse at 23% 48%, rgba(201,166,107,.088), transparent 26rem),
    radial-gradient(ellipse at 78% 42%, rgba(201,166,107,.092), transparent 28rem),
    radial-gradient(ellipse at 15% 30%, rgba(255,255,255,.66), transparent 25rem),
    linear-gradient(160deg, #FFFDF8, rgba(252,247,238,.95) 54%, rgba(248,239,223,.94));
  border: 0;
  box-shadow: none;
  overflow: hidden;
  font-family: var(--font-sans-zh);
  line-height: 1.45;
}

/* FINAL LOCK: bottom strip title consistency + bottom status text visibility */
#dashboardBottomStrip .dashboard-strip-title {
  font-family: var(--font-sans-zh) !important;
  font-size: 15px !important;
  font-weight: 650 !important;
  line-height: 1.2 !important;
  letter-spacing: 0 !important;
}

/* ===== Bottom Nav: Base (desktop default) ===== */
.dashboard-bottom-nav {
  min-height: 68px !important;
  height: auto !important;
  overflow: visible !important;
}

.dashboard-bottom-status,
.dashboard-status-item {
  overflow: visible !important;
  padding-top: 4px !important;
  padding-bottom: 4px !important;
}

.dashboard-status-item span,
.dashboard-status-item strong {
  line-height: 1.35 !important;
}

/* FINAL OVERRIDE: bottom strip internal balance (desktop/tablet) */
@media (min-width: 901px) {
  #dashboardBottomStrip.dashboard-bottom-strip .dashboard-strip-item {
    align-items: center !important;
    justify-items: stretch !important;
    padding: 3px 12px !important;
  }

  #dashboardBottomStrip .dashboard-strip-block {
    grid-template-rows: 20px 1fr !important;
    align-content: stretch !important;
    justify-content: stretch !important;
    height: 100% !important;
  }

  #dashboardBottomStrip .dashboard-strip-title {
    justify-self: start !important;
    align-self: start !important;
    text-align: left !important;
  }

  #dashboardBottomStrip .dashboard-strip-body {
    display: grid !important;
    align-content: center !important;
    justify-items: stretch !important;
    gap: 3px !important;
    min-height: 0 !important;
    width: 100% !important;
  }

  #dashboardBottomStrip .dashboard-strip-donut-row,
  #dashboardBottomStrip .dashboard-strip-allocation-row {
    min-height: 0 !important;
    align-items: center !important;
  }

  #dashboardBottomStrip .dashboard-strip-list span {
    font-size: 12px !important;
    line-height: 1.2 !important;
  }

  #dashboardBottomStrip .dashboard-strip-invest-line,
  #dashboardBottomStrip .dashboard-strip-sparkline {
    width: 100% !important;
    justify-self: stretch !important;
  }

  #dashboardBottomStrip .dashboard-strip-goal .dashboard-strip-progress,
  #dashboardBottomStrip .dashboard-strip-cash .dashboard-strip-bar,
  #dashboardBottomStrip .dashboard-strip-cash .dashboard-strip-split {
    width: 82% !important;
  }

  #dashboardBottomStrip .dashboard-strip-quote .dashboard-strip-body {
    align-content: center !important;
  }

  #dashboardBottomStrip .dashboard-strip-quote-main {
    font-size: 24px !important;
    line-height: 1.1 !important;
  }

  #dashboardBottomStrip .dashboard-strip-quote .dashboard-strip-desc {
    font-size: 12px !important;
    line-height: 1.4 !important;
    max-width: 88% !important;
    white-space: normal !important;
    overflow: visible !important;
    text-overflow: clip !important;
  }

  /* bottom status text visibility is locked by the global FINAL LOCK block above */
}

.dashboard-cockpit-page::before,
.dashboard-cockpit-page::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.dashboard-cockpit-page::before {
  inset: 0;
  background:
    radial-gradient(ellipse at 50% 48%, rgba(217,181,112,.13), transparent 38rem),
    radial-gradient(ellipse at 32% 72%, rgba(255,255,255,.42), transparent 26rem),
    radial-gradient(ellipse at 16% 44%, rgba(255,255,255,.50), transparent 22rem),
    radial-gradient(ellipse at 84% 42%, rgba(255,255,255,.42), transparent 22rem),
    linear-gradient(90deg, rgba(255,255,255,.18), transparent 28%, transparent 72%, rgba(255,255,255,.20));
  opacity: .92;
}

.dashboard-cockpit-page::after {
  display: block;
  inset: 0;
  background:
    linear-gradient(28deg, transparent 0 35%, rgba(201,166,107,.045) 35.1% 35.35%, transparent 35.6%),
    linear-gradient(152deg, transparent 0 36%, rgba(201,166,107,.04) 36.1% 36.35%, transparent 36.6%);
  opacity: .7;
}

.dashboard-topbar,
.dashboard-main-grid,
.dashboard-bottom-strip,
.dashboard-bottom-nav,
.dashboard-bottom-status,
.dashboard-bottom-nav-actions {
  position: relative;
  z-index: 1;
}

.dashboard-topbar {
  display: grid;
  grid-template-columns: minmax(230px, .75fr) minmax(520px, 1.55fr) auto;
  gap: 14px;
  align-items: center;
}

.dashboard-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.dashboard-brand-mark {
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  border: 1px solid rgba(201,166,107,.46);
  background:
    radial-gradient(circle at 32% 24%, rgba(255,255,255,.96), transparent 42%),
    linear-gradient(145deg, rgba(255,253,248,.88), rgba(243,230,206,.58));
  color: var(--primary-dark);
  font-family: var(--font-serif-zh);
  font-size: 1.75rem;
  font-weight: 700;
  letter-spacing: .01em;
  box-shadow: inset 0 0 0 3px rgba(255,255,255,.52), 0 8px 20px rgba(133,100,52,.065);
}

.dashboard-brand h2 {
  margin: 0;
  font-family: var(--font-serif-zh);
  font-size: clamp(1.5rem, 1.45vw, 1.75rem);
  font-weight: 700;
  letter-spacing: .01em;
  line-height: 1.16;
  color: var(--text);
}

.dashboard-brand p {
  margin: 2px 0 0;
  color: var(--muted);
  font-family: var(--font-sans-zh);
  font-size: .82rem;
  font-weight: 500;
  line-height: 1.4;
}

.dashboard-status-bar {
  min-width: 0;
  display: grid;
  grid-template-columns: repeat(3, max-content);
  justify-content: center;
  justify-items: center;
  gap: 8px;
  transform: translateX(-100px);
}

.dashboard-status-pill,
.dashboard-panel {
  border: 1px solid var(--glass-line);
  background:
    radial-gradient(circle at 20% 0%, rgba(255,255,255,.56), transparent 9rem),
    linear-gradient(145deg, var(--glass-cream), var(--glass-cream-soft));
  box-shadow:
    0 10px 24px rgba(133,100,52,.032),
    inset 0 1px 0 var(--glass-line-bright),
    inset 0 -1px 0 rgba(201,166,107,.060);
  backdrop-filter: blur(24px) saturate(1.08);
  -webkit-backdrop-filter: blur(24px) saturate(1.08);
}

.dashboard-status-pill {
  min-height: 30px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 6px 14px;
  border-radius: var(--radius-pill);
  width: fit-content;
  max-width: none;
  white-space: nowrap;
}

.dashboard-status-pill span {
  color: var(--primary-dark);
  font-family: var(--font-sans-zh);
  font-size: .66rem;
  font-weight: 600;
  white-space: nowrap;
}

.dashboard-status-pill strong {
