.dashboard-goal-ring span {
  color: var(--primary-dark);
  font-family: var(--font-number);
  font-size: .66rem;
  font-weight: 700;
  letter-spacing: -.02em;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

.dashboard-goal-visual strong,
.dashboard-goal-visual p {
  display: block;
}

.dashboard-goal-visual p {
