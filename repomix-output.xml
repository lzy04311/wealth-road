  line-height: 1.25;
}

.dashboard-strip-foot {
  color: rgba(104,90,68,.92);
  font-size: 12px;
  line-height: 1.25;
}

.dashboard-strip-donut-row {
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr);
  gap: 10px;
  align-items: center;
  justify-items: start;
}

.dashboard-strip-donut-lg {
  width: 56px;
  box-shadow: inset 0 0 0 1px rgba(201,166,107,.12);
}

.dashboard-strip-donut-lg span {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  color: rgba(170,132,68,.72);
  font-size: 13px;
}

.dashboard-strip-list {
  min-width: 0;
  display: grid;
  gap: 2px;
  align-content: center;
  justify-content: start;
}

.dashboard-strip-list span {
  display: flex;
  align-items: center;
  gap: 6px;
  color: rgba(106,93,72,.92);
  font-size: 12px;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dashboard-strip-list i {
  width: 4px !important;
  height: 4px !important;
  min-width: 4px !important;
  min-height: 4px !important;
  border: 0 !important;
  border-radius: 999px !important;
  background: rgba(184,136,67,.82) !important;
  box-shadow: none !important;
  display: inline-block !important;
  place-items: initial !important;
  flex: 0 0 auto !important;
}

.dashboard-strip-double {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 10px;
}

.dashboard-strip-double strong {
  font-size: 16px;
  line-height: 1.1;
}

.dashboard-strip-double b {
  color: rgba(106,93,72,.92);
  font-family: var(--font-number);
  font-size: 14px;
  font-weight: 700;
}

.dashboard-strip-invest-line {
  width: 100%;
  justify-self: stretch;
  margin-top: 2px;
}

.dashboard-strip-invest .dashboard-strip-body {
  grid-template-rows: auto auto auto;
}

.dashboard-strip-allocation-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 58px;
  gap: 10px;
  align-items: center;
  justify-items: start;
}

.dashboard-strip-goal .dashboard-strip-progress {
  width: 84%;
}

.dashboard-strip-goal .dashboard-strip-progress b {
  height: 7px;
}

.dashboard-strip-quote-main {
  font-size: 24px;
  line-height: 1;
  color: #5C3D14;
  font-family: var(--font-serif-zh);
  font-weight: 700;
}

.dashboard-strip-quote .dashboard-strip-desc {
  max-width: 90%;
  font-size: 12px;
  line-height: 1.4;
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
}

.dashboard-strip-cash .dashboard-strip-kv {
  margin-top: 1px;
}

.dashboard-strip-invest .dashboard-strip-sub {
  margin-top: -1px;
}

.dashboard-strip-donut-empty {
  background:
    radial-gradient(circle, rgba(255,253,248,.94) 0 42%, transparent 43%),
    conic-gradient(from 12deg, rgba(201,166,107,.26), rgba(201,166,107,.10));
}

.dashboard-strip-donut {
  background:
    radial-gradient(circle, rgba(255,253,248,.92) 0 44%, transparent 45%),
    radial-gradient(circle at 34% 24%, rgba(255,255,255,.62), transparent 28%),
    conic-gradient(var(--strip-donut));
}

.dashboard-bottom-nav {
  position: relative;
  z-index: 1;
  min-height: 60px;
  display: grid;
  grid-template-columns: minmax(560px, 1.08fr) minmax(700px, 1fr);
  gap: 0;
  align-items: center;
  margin-inline: 30px;
  padding: 6px 16px;
  border-radius: 24px;
  background:
    radial-gradient(circle at 8% 50%, rgba(218,184,119,.052), transparent 18rem),
    linear-gradient(145deg, rgba(255,253,248,.50), rgba(250,244,232,.26));
  box-shadow:
    0 6px 16px rgba(133,100,52,.018),
    inset 0 1px 0 rgba(255,255,255,.62);
}

/* ===== Bottom Status: Base (desktop default) ===== */
.dashboard-bottom-status {
  position: relative;
  z-index: 1;
  min-width: 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
}

/* ===== Bottom Status Item: Base ===== */
.dashboard-status-item {
  position: relative;
  z-index: 1;
  min-width: 0;
  display: grid;
  grid-template-columns: 21px minmax(0, 1fr);
  gap: 7px;
  align-items: center;
  padding: 3px 13px;
  border-right: 1px solid rgba(201,166,107,.085);
}

.dashboard-status-item:last-child {
  border-right: 0;
}

.dashboard-status-item i {
  width: 21px;
  height: 21px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  border: 1px solid rgba(201,166,107,.16);
  background:
    radial-gradient(circle at 34% 30%, rgba(255,255,255,.78), transparent 48%),
    rgba(255,253,248,.34);
}

.dashboard-status-item i::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: inherit;
  background: #9F7338;
  box-shadow: 0 0 0 4px rgba(201,166,107,.060), 0 0 8px rgba(210,174,105,.14);
}

.dashboard-status-item i.positive::before {
  background: var(--success);
  box-shadow: 0 0 0 4px rgba(79,138,98,.070), 0 0 8px rgba(79,138,98,.12);
}

.dashboard-status-item span,
.dashboard-status-item strong {
  display: block;
  white-space: nowrap;
  overflow: visible;
  text-overflow: clip;
}

.dashboard-status-item span {
  color: var(--text);
  font-family: var(--font-sans-zh);
  font-size: .70rem;
  font-weight: 600;
  line-height: 1.35;
}

.dashboard-status-item strong {
  margin-top: 1px;
  color: var(--muted);
  font-family: var(--font-number);
  font-size: .62rem;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -.02em;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ===== Bottom Nav Actions: Base ===== */
.dashboard-bottom-nav-actions {
  min-width: 0;
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 6px;
  align-items: center;
  padding-left: 14px;
  border-left: 1px solid rgba(201,166,107,.10);
}

.dashboard-bottom-nav button {
  min-width: 0;
  min-height: 36px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--muted);
  font-family: var(--font-sans-zh);
  font-size: .74rem;
  font-weight: 600;
  line-height: 1.35;
}

.dashboard-bottom-nav span {
  width: 20px;
  height: 20px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  color: var(--primary-dark);
  font-family: var(--font-serif-zh);
  font-size: .9rem;
  font-weight: 700;
}

.dashboard-bottom-nav strong {
  font-family: var(--font-sans-zh);
  font-size: .78rem;
  font-weight: 600;
  letter-spacing: 0;
}

.dashboard-bottom-nav button:hover {
  background: rgba(243,230,206,.28);
  color: var(--text);
}

.dashboard-bottom-nav button.active {
  background:
    radial-gradient(circle at 50% 55%, rgba(220,178,101,.22), transparent 68%),
    radial-gradient(circle at 32% 20%, rgba(255,255,255,.86), transparent 46%),
    linear-gradient(145deg, rgba(255,253,248,.78), rgba(244,227,194,.42));
  color: var(--primary-dark);
  box-shadow:
    inset 0 0 0 1px rgba(220,188,132,.32),
    inset 0 1px 0 rgba(255,255,255,.82),
    0 0 0 4px rgba(201,166,107,.034),
    0 0 22px rgba(220,178,101,.18),
    0 5px 12px rgba(133,100,52,.030);
}

.positive { color: var(--success) !important; }
.negative { color: var(--danger) !important; }
.warning { color: var(--warning) !important; }

#healthModalBody { text-align: center; }
#healthModalBody h3 { margin-bottom: 12px; font-size: 1.1rem; color: var(--text); }
#healthModalBody p { margin: 6px 0; font-size: .9rem; color: var(--muted); line-height: 1.6; }
#healthModalBody b { color: var(--text); }

/* ===== Bottom Area: <=1180 ===== */
@media (max-width: 1180px) {
  .dashboard-topbar,
  .dashboard-main-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-status-bar {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    transform: none;
  }

  .dashboard-status-pill {
    width: 100%;
  }

  .dashboard-home-actions {
    justify-self: start;
  }

  .dashboard-center-orbit {
    min-height: 480px;
  }

  .dashboard-bottom-strip {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    row-gap: 14px;
  }

  .dashboard-strip-item:nth-child(3n) {
    border-right: 0;
  }

  .dashboard-bottom-nav {
    grid-template-columns: 1fr;
    border-radius: 24px;
