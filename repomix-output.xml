.data-save-note { margin-top: 12px; }
.import-card { border-color: var(--accent); background: linear-gradient(145deg, var(--surface), var(--soft-gold)); }
.import-warning { margin: 0; border-color: var(--accent); background: var(--soft-gold); color: var(--primary-dark); font-weight: 600; }
