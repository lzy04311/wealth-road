.dashboard-home-action {
  width: 44px;
  height: 44px;
  min-height: 44px;
  padding: 0;
  border: 1px solid rgba(220,190,136,.52);
  border-radius: 999px;
  background:
    radial-gradient(circle at 32% 20%, rgba(255,255,255,.96), transparent 42%),
    linear-gradient(180deg, rgba(255,255,255,.32), transparent 34%),
    linear-gradient(145deg, rgba(255,253,248,.78), rgba(243,230,206,.42));
  color: var(--primary-dark);
  font-family: var(--font-serif-zh);
  font-size: 1.12rem;
  font-weight: 700;
  line-height: 1;
  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.46),
    inset 0 -8px 16px rgba(214,178,111,.075),
    0 8px 18px rgba(133,100,52,.052),
    0 0 0 4px rgba(255,244,221,.18);
}

.dashboard-home-action:hover {
  background:
    radial-gradient(circle at 32% 20%, rgba(255,255,255,1), transparent 42%),
