}

.dashboard-backup-card::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 30px;
  pointer-events: none;
  opacity: .34;
  background:
    linear-gradient(135deg, transparent 0 26%, rgba(143,181,143,.12) 27% 34%, transparent 35%),
