  stroke-linecap: round;
  stroke-linejoin: round;
}

.dashboard-mini-sparkline circle {
  fill: #CFA654;
  stroke: rgba(255,253,248,.92);
  stroke-width: 1.4;
}

.dashboard-risk-card .dashboard-risk-bar {
  position: relative;
  height: 9px;
  align-self: end;
  margin-top: 1px;
  background:
    linear-gradient(90deg, rgba(201,166,107,.11), rgba(201,166,107,.045));
