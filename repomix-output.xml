  font-weight: 600;
}
.income-tooltip {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 10px);
  transform: translateX(-50%);
  min-width: 150px;
  padding: 8px 10px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--muted);
  font-size: .74rem;
  text-align: left;
  box-shadow: var(--shadow-soft);
  opacity: 0;
  pointer-events: none;
  transition: opacity .15s ease;
  z-index: 2;
}
.income-bar-item:hover .income-tooltip,
.income-bar-item:focus-within .income-tooltip { opacity: 1; }
.collapsible-form { display: none; margin-bottom: 18px; }
.collapsible-form.open { display: block; animation: softOpen .18s ease-out; }
@keyframes softOpen { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
/* ========== Forms ========== */
/* TODO: 后续迁移到 components.css。 */
.form-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14px; }
.field { display: flex; flex-direction: column; gap: 7px; }
.field.wide { grid-column: 1 / -1; }
.field label { color: var(--muted); font-size: .8rem; font-weight: 600; }
input, select, textarea { width: 100%; min-height: 44px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface-soft); color: var(--text); padding: 8px 12px; outline: none; transition: border-color .15s, box-shadow .15s, background .15s; }
input:focus, select:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(201,168,106,.16); background: var(--surface); }
textarea { min-height: 150px; resize: vertical; }
.check-field { display: flex; gap: 8px; align-items: center; min-height: 46px; color: var(--text); }
.check-field input { width: 18px; min-height: 18px; accent-color: var(--primary); }
/* ========== Buttons ========== */
/* TODO: 后续迁移到 components.css。 */
.actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
.btn { min-height: 40px; border: 1px solid transparent; border-radius: var(--radius-sm); padding: 8px 16px; background: var(--surface-soft); color: var(--text); font-weight: 600; transition: background .15s, box-shadow .15s, transform .15s; }
.btn:hover { box-shadow: var(--shadow-xs); }
.btn.primary { background: linear-gradient(135deg, #2B2D2F, #4D4E50); color: var(--surface); border-color: rgba(201,168,106,.42); box-shadow: 0 6px 18px rgba(29,29,31,.14), inset 0 0 0 1px rgba(216,180,95,.34); }
.btn.primary:hover { background: #1D1D1F; box-shadow: 0 10px 24px rgba(29,29,31,.20), inset 0 0 0 1px rgba(216,180,95,.46); transform: translateY(-1px); }
.btn.ghost { border-color: var(--line); color: var(--muted); }
.btn.danger { background: transparent; color: var(--danger); }
.btn.danger:hover { background: rgba(184,91,80,.10); box-shadow: 0 4px 12px rgba(184,91,80,.14); }
.btn.small { min-height: 32px; padding: 4px 12px; font-size: .82rem; }
/* ========== Records ========== */
.record-card { display: flex; flex-direction: column; min-height: 180px; padding: 16px; border-radius: var(--radius-lg); }
.expense-calendar-wrap { margin-top: 8px; }
.calendar-card {
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: rgba(255,254,250,.9);
  padding: 12px;
  box-shadow: var(--shadow-sm);
}
.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8px;
  margin-bottom: 8px;
}
.calendar-weekdays span {
  text-align: center;
  color: var(--muted);
  font-size: .78rem;
  font-weight: 600;
}
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8px;
}
.cal-day {
  min-height: 92px;
  border: 1px solid rgba(226,221,211,.85);
  border-radius: var(--radius-md);
  background: rgba(248,246,241,.75);
  padding: 8px;
  text-align: left;
  color: var(--text);
}
.cal-day.empty-day {
  background: rgba(255,254,250,.5);
  border-style: dashed;
}
.cal-day.has-expense {
  background: linear-gradient(180deg, rgba(201,168,106, calc(0.08 + var(--heat) * 0.18)), rgba(248,246,241,.9));
}
.cal-day.is-today {
  box-shadow: inset 0 0 0 2px rgba(201,168,106,.34);
}
.cal-day.is-selected {
  border-color: var(--primary);
  box-shadow: 0 0 0 2px rgba(201,168,106,.18);
}
.cal-date { font-size: .9rem; font-weight: 700; }
.cal-amount { margin-top: 4px; font-size: .76rem; color: var(--primary-dark); font-weight: 600; }
.cal-summary {
  margin-top: 4px;
  font-size: .7rem;
  color: var(--muted);
  line-height: 1.3;
  max-height: 2.7em;
  overflow: hidden;
}
.cal-extra { margin-top: 3px; font-size: .7rem; color: var(--primary-dark); font-weight: 600; }
.calendar-detail { margin-top: 12px; }
.record-card .row-title { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; font-weight: 700; }
.row-meta { margin-top: 8px; color: var(--muted); font-size: .84rem; overflow-wrap: anywhere; }
.row-amount { margin-top: 10px; color: var(--text); font-size: 1.28rem; font-weight: 700; }
.row-actions { display: flex; gap: 6px; margin-top: auto; padding-top: 14px; }
.badge { display: inline-flex; align-items: center; border-radius: 999px; padding: 3px 9px; background: var(--soft-gold); color: var(--primary-dark); font-size: .72rem; font-weight: 600; }
.notice { margin: 0 0 12px; padding: 12px 16px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--soft-gold); color: var(--primary-dark); }
.notice.positive { background: var(--soft-green); color: var(--success); border-color: rgba(79,138,98,.28); }
.notice.negative { background: rgba(184,91,80,.10); color: var(--danger); border-color: rgba(184,91,80,.30); }
.empty { border: 1px dashed var(--line); border-radius: var(--radius-md); padding: 34px 24px; text-align: center; color: var(--muted); background: var(--surface-soft); }
.empty-card {
  border-style: solid;
  border-color: rgba(226,221,211,.9);
  border-radius: 24px;
  background: linear-gradient(160deg, var(--surface), var(--surface-soft));
}
.empty-emoji { font-size: 1.6rem; line-height: 1; margin-bottom: 8px; }
.empty-title { color: var(--text); font-size: 1rem; font-weight: 700; }
.empty-desc { margin-top: 6px; color: var(--muted); font-size: .88rem; }
.empty-action { margin-top: 10px; color: var(--muted); font-size: .82rem; font-weight: 600; }
.table-wrap { overflow-x: auto; }
table { width: 100%; min-width: 860px; border-collapse: collapse; }
th, td { padding: 13px 14px; border-bottom: 1px solid var(--line); text-align: left; font-size: .88rem; }
th { background: var(--soft-gold); color: var(--primary-dark); font-size: .78rem; }
td { background: rgba(255,254,250,.82); }
tr:hover td { background: var(--surface-soft); }
/* ========== Data / Backup Page ========== */
.data-actions { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; align-items: stretch; }
.data-card { display: flex; flex-direction: column; gap: 12px; }
.data-card h2 { margin-bottom: 0; }
.data-card .subtitle { margin: 0; }
.data-card .btn { align-self: flex-start; }
