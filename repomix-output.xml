}

.dashboard-strip-sparkline polyline {
  fill: none;
  stroke: rgba(184,136,67,.82);
  stroke-width: 1.4;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.dashboard-strip-sparkline circle {
  fill: #FFF7E8;
  stroke: rgba(184,136,67,.86);
  stroke-width: 1.3;
}

.dashboard-strip-quote {
  isolation: isolate;
}

.dashboard-strip-quote .dashboard-strip-body {
  position: relative;
  justify-items: start !important;
}

.dashboard-strip-quote .dashboard-strip-body strong,
.dashboard-strip-quote .dashboard-strip-body small {
  justify-self: start;
}

.dashboard-strip-item i.dashboard-strip-quote-mark {
  display: inline;
  width: auto;
  height: auto;
  border: 0;
  border-radius: 0;
  background: none;
  box-shadow: none;
  place-items: initial;
  font-family: var(--font-serif-zh);
  font-size: 20px;
  font-weight: 400;
  color: rgba(201,166,107,.28);
  font-style: normal;
  line-height: 0;
  vertical-align: -2px;
  margin-right: 2px;
}

.dashboard-strip-quote-art {
  position: absolute;
  right: 4px;
  bottom: -2px;
  width: 60px;
  height: 42px;
  z-index: -1;
  opacity: .12;
  background:
    linear-gradient(172deg, transparent 0 60%, rgba(201,166,107,.20) 61% 62%, transparent 63%),
    linear-gradient(168deg, transparent 0 48%, rgba(201,166,107,.14) 49% 50%, transparent 51%),
    linear-gradient(176deg, transparent 0 38%, rgba(201,166,107,.10) 39% 40%, transparent 41%);
  -webkit-mask: linear-gradient(180deg, #000 0%, transparent 100%);
  mask: linear-gradient(180deg, #000 0%, transparent 100%);
}

.dashboard-strip-goal-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 8px;
  width: 100%;
}

.dashboard-strip-goal-head span {
  color: var(--muted);
  font-size: 12px;
  font-weight: 500;
}

.dashboard-strip-goal-head strong {
  font-size: 22px;
  line-height: 1;
  font-family: var(--font-number);
}

.dashboard-strip-goal .dashboard-strip-progress {
  width: 84%;
}

.dashboard-strip-goal .dashboard-strip-progress b {
  height: 7px;
  background: linear-gradient(90deg, #C5A166 var(--strip-progress), rgba(201,166,107,.08) 0);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.36);
}

.dashboard-strip-goal-foot {
  display: flex;
  justify-content: space-between;
  gap: 6px;
  width: 84%;
  font-size: 12px;
}

.dashboard-strip-goal-foot span {
  color: rgba(104,90,68,.92);
  font-size: 12px;
  line-height: 1.25;
}

.dashboard-strip-goal-foot span:last-child {
  text-align: right;
}

/* Bottom Strip Exact Layout Override */
.dashboard-bottom-strip .dashboard-strip-item {
  grid-template-columns: 1fr;
  gap: 0;
  padding: 8px 16px;
  align-items: center;
  justify-items: stretch;
}

.dashboard-bottom-strip .dashboard-strip-item::after {
  height: 46%;
}

.dashboard-strip-block {
  min-width: 0;
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-rows: auto 1fr;
  align-content: stretch;
  justify-content: stretch;
  justify-self: stretch;
}

.dashboard-strip-body {
  min-width: 0;
  width: 100%;
  height: 100%;
  display: grid;
  align-content: center;
  justify-items: stretch;
  gap: 4px;
}

.dashboard-strip-block em {
  font-style: normal;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.2;
}

.dashboard-strip-kv {
