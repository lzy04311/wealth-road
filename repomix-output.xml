  box-shadow:
    inset 0 0 0 1px rgba(201,166,107,.07),
    0 0 16px rgba(255,253,248,.34);
}

.dashboard-structure-list {
  display: grid;
  gap: 8px;
  align-content: center;
}

.dashboard-structure-list div {
  display: grid;
  grid-template-columns: 8px minmax(0, 1fr) 38px minmax(58px, auto);
  column-gap: 7px;
  align-items: baseline;
  color: var(--muted);
  font-family: var(--font-sans-zh);
  font-size: .78rem;
  font-weight: 500;
  line-height: 1.35;
}

.dashboard-structure-list span {
  width: 8px;
  height: 8px;
  align-self: center;
  border-radius: 999px;
}

.dashboard-structure-list strong {
  font-family: var(--font-sans-zh);
  font-size: .78rem;
  font-weight: 600;
  letter-spacing: 0;
}

.dashboard-structure-list em {
  font-family: var(--font-number);
  font-style: normal;
  color: var(--text);
  text-align: right;
  letter-spacing: -.02em;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

.dashboard-structure-list b {
  color: rgba(91,78,58,.78);
  font-family: var(--font-number);
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: -.02em;
  text-align: right;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

.dashboard-risk-bar,
.dashboard-insight-line,
.dashboard-progress-ring,
.dashboard-check-mark {
  height: 7px;
  border-radius: 999px;
  background: rgba(201,166,107,.105);
  overflow: hidden;
}

.dashboard-risk-bar::before {
  content: "";
  display: block;
  width: 72%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, rgba(185,141,78,.62), rgba(201,166,107,.86));
}

.dashboard-insight-line::before {
  content: "";
  display: block;
  width: 64%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, rgba(201,166,107,.30), rgba(185,141,78,.68));
}

.dashboard-progress-ring,
.dashboard-check-mark {
  height: 30px;
  display: grid;
  place-items: center;
  background: linear-gradient(90deg, rgba(201,166,107,.075), rgba(255,253,248,.20));
