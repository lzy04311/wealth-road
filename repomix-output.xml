  box-shadow: none;
}

.module-page-mode .ip-card-hero,
.module-page-mode .ip-card-metrics > div,
.module-page-mode .role-primary,
.module-page-mode .role-metrics .metric-item,
#goals .account-mini {
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.module-page-mode .ip-card-hero {
