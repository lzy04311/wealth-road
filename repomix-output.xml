  place-items: center;
  background:
    radial-gradient(circle, rgba(255,253,248,.88) 0 52%, transparent 53%),
    conic-gradient(rgba(185,141,78,.88) var(--goal-progress), rgba(201,166,107,.13) 0);
  box-shadow: inset 0 0 0 1px rgba(201,166,107,.13);
