    left: auto;
    top: auto;
    transform: none;
    justify-self: center;
    width: 144px;
    height: 144px;
    animation: none;
  }

  .dashboard-cockpit-page .compass-core strong {
    font-size: 4rem;
  }

  .dashboard-cockpit-page .compass-node-layer {
    position: relative;
    inset: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    width: 100%;
    transform: none;
  }

  .dashboard-cockpit-page .compass-node {
    position: relative;
    left: auto;
    top: auto;
    width: 100%;
    min-height: 82px;
    transform: none;
    grid-template-columns: 12px minmax(0, 1fr);
    grid-template-areas:
      "dot name"
      "dot value"
      "dot desc";
    justify-items: start;
    text-align: left;
    border-radius: 16px;
    padding: 10px;
  }

  .dashboard-cockpit-page .compass-node::before {
    display: none;
  }

  .dashboard-cockpit-page .node-name,
  .dashboard-cockpit-page .node-desc,
  .dashboard-cockpit-page .compass-node strong {
    justify-self: start;
    max-width: 100%;
    text-align: left;
  }

  .dashboard-cockpit-page .node-desc {
    white-space: normal;
  }

  .node-dot {
    position: relative;
    transform: none;
    width: 9px;
    height: 9px;
    grid-area: dot;
  }

  .node-dot::before {
    inset: 0;
  }

  .compass-node:hover {
    transform: none;
  }

  .dashboard-structure {
    grid-template-columns: 1fr;
    justify-items: center;
  }
}

@media (max-width: 380px) {
  .dashboard-cockpit-page {
    padding-inline: 8px;
  }

  .dashboard-brand-mark {
    width: 38px;
    height: 38px;
    flex-basis: 38px;
  }

  .dashboard-brand h2 {
    font-size: 1.12rem;
  }

  .dashboard-brand p {
    display: none;
  }

  .dashboard-home-action {
    width: 34px;
    height: 34px;
    min-height: 34px;
  }
}
