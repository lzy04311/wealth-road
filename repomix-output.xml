function daysSinceDate(dateText) {
  if (!dateText || !/^\d{4}-\d{2}-\d{2}$/.test(String(dateText))) return null;
  var parts = String(dateText).split("-").map(Number);
  var target = new Date(parts[0], parts[1] - 1, parts[2]);
