}

.module-page-mode .module-page-header span,
.context-label,
.subpage-inspector-head span {
  color: var(--primary-dark);
  font-size: .7rem;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.module-page-mode .module-page-header h2 {
  font-family: var(--font-serif-zh);
  font-size: 1.42rem;
  line-height: 1.15;
}

.module-page-mode .module-page-header p {
