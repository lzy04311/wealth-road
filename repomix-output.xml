<file path="styles/dashboard/layout-bottom-nav.css">
.dashboard-bottom-nav {
  position: relative;
  z-index: 1;
  min-height: 60px;
  display: grid;
  grid-template-columns: minmax(560px, 1.08fr) minmax(700px, 1fr);
  gap: 0;
  align-items: center;
  margin-inline: 30px;
  padding: 6px 16px;
  border-radius: 24px;
  background:
    radial-gradient(circle at 8% 50%, rgba(218,184,119,.052), transparent 18rem),
    linear-gradient(145deg, rgba(255,253,248,.50), rgba(250,244,232,.26));
  box-shadow:
    0 6px 16px rgba(133,100,52,.018),
    inset 0 1px 0 rgba(255,255,255,.62);
}

/* ===== Bottom Status: Base (desktop default) ===== */
.dashboard-bottom-status {
  position: relative;
  z-index: 1;
  min-width: 0;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0;
  align-items: center;
}

/* ===== Bottom Status Item: Base ===== */
.dashboard-status-item {
  position: relative;
  z-index: 1;
  min-width: 0;
  display: grid;
  grid-template-columns: 21px minmax(0, 1fr);
  gap: 6px;
  align-items: center;
  padding: 3px 10px;
  border-right: 1px solid rgba(201,166,107,.085);
}

.dashboard-status-item:last-child {
  border-right: 0;
}

.dashboard-status-item i {
  width: 21px;
  height: 21px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  border: 1px solid rgba(201,166,107,.16);
  background:
    radial-gradient(circle at 34% 30%, rgba(255,255,255,.78), transparent 48%),
    rgba(255,253,248,.34);
}

.dashboard-status-item i::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: inherit;
  background: #9F7338;
  box-shadow: 0 0 0 4px rgba(201,166,107,.060), 0 0 8px rgba(210,174,105,.14);
}

.dashboard-status-item i.positive::before {
  background: var(--success);
  box-shadow: 0 0 0 4px rgba(79,138,98,.070), 0 0 8px rgba(79,138,98,.12);
}

.dashboard-status-item span,
.dashboard-status-item strong {
  display: block;
  white-space: nowrap;
  overflow: visible;
  text-overflow: clip;
}

.dashboard-status-item span {
  color: var(--text);
  font-family: var(--font-sans-zh);
  font-size: .68rem;
  font-weight: 600;
  line-height: 1.35;
}

.dashboard-status-item strong {
  margin-top: 1px;
  color: var(--muted);
  font-family: var(--font-number);
  font-size: .60rem;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -.02em;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ===== Bottom Nav Actions: Base ===== */
.dashboard-bottom-nav-actions {
  min-width: 0;
  min-height: 0;
  height: 100%;
  display: flex;
  gap: 6px;
  align-items: center;
  justify-content: space-between;
  align-self: center;
  padding-left: 14px;
  border-left: 1px solid rgba(201,166,107,.10);
}

.dashboard-bottom-nav button {
  flex: 1 1 0;
  min-width: 0;
  height: 38px;
  display: grid;
  grid-template-columns: auto auto;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--muted);
  font-family: var(--font-sans-zh);
  font-size: .74rem;
  font-weight: 600;
  line-height: 1.35;
}

.dashboard-bottom-nav span {
  width: 20px;
  height: 20px;
  display: grid;
  place-items: center;
  align-self: center;
  border-radius: 999px;
  color: var(--primary-dark);
  font-family: var(--font-serif-zh);
  font-size: .9rem;
  font-weight: 700;
}

.dashboard-bottom-nav strong {
  align-self: center;
  font-family: var(--font-sans-zh);
  font-size: .78rem;
  font-weight: 600;
