.module-page-mode .assets-panorama-card { border-radius: 18px; }

.module-page-mode .ap-hero {
  border: 0;
  border-radius: 0;
  background: transparent;
}

.module-page-mode .ap-metric {
  border: 0;
  border-left: 1px solid rgba(209,184,139,.22);
  border-radius: 0;
  background: transparent;
}

.module-page-mode .ap-metric:first-child { border-left: 0; }

.module-page-mode .asset-kind-tabs {
  margin-bottom: 4px;
  border-bottom: 1px solid var(--workspace-line);
}

.module-page-mode .asset-kind-tabs button { border-radius: 10px; }

.goal-page-intro {
  min-height: 112px;
  margin-bottom: 12px;
  padding: 22px 24px;
  border-radius: 18px;
}

.goal-page-intro h2 {
  margin-top: 4px;
  font-family: var(--font-serif-zh);
  font-size: 1.35rem;
}

.goal-page-intro p { margin: 5px 0 0; color: var(--muted); }

#goals .account-grid { grid-template-columns: 1fr; }

#goals .account-card {
  min-height: 176px;
  padding: 22px;
  display: grid;
  grid-template-columns: minmax(220px, .72fr) minmax(360px, 1.28fr);
  grid-template-rows: auto auto auto;
  gap: 10px 24px;
  align-items: center;
}

#goals .account-card .account-top {
  grid-column: 1;
  grid-row: 1 / 4;
