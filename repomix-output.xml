.dashboard-risk-card .dashboard-risk-bar::before {
  width: 38%;
  background: linear-gradient(90deg, rgba(185,141,78,.62), rgba(219,186,125,.86));
}

.dashboard-risk-card .dashboard-risk-bar span {
  position: absolute;
  inset: 0;
  overflow: hidden;
  text-indent: -999px;
