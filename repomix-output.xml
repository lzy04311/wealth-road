/* ========== Design Tokens / Variables ========== */
:root {
  --bg: #F8F3EA;
  --surface: #FFFDF8;
  --surface-soft: #F8F1E6;
  --text: #23201B;
  --muted: #817866;
  --line: rgba(209, 184, 139, .36);
  --primary: #C9A66B;
  --primary-dark: #8E6A32;
  --accent: #D5B16F;
  --accent-soft: #F3E6CE;
  --champagne-line: rgba(201, 166, 107, .42);
  --paper-glass: rgba(255, 253, 248, .68);
  --paper-glass-strong: rgba(255, 253, 248, .84);
  --success: #4F8A62;
  --warning: #B28A3E;
  --danger: #B85B50;
  --soft-green: #E9F0E8;
  --soft-gold: var(--accent-soft);
  --yellow: var(--accent);
  --green: var(--success);
  --blue: #8F8A7E;

  /* 阴影 4 档 */
  --shadow-xs: 0 1px 5px rgba(112, 84, 42, 0.04);
  --shadow-sm: 0 8px 22px rgba(133, 100, 52, 0.07);
  --shadow-md: 0 18px 42px rgba(133, 100, 52, 0.10);
  --shadow-lg: 0 26px 64px rgba(133, 100, 52, 0.13);

  /* 圆角 4 档 */
  --radius-sm: 12px;
  --radius-md: 18px;
  --radius-lg: 24px;
  --radius-pill: 999px;
  --radius: var(--radius-lg);

  /* 旧变量兼容 */
  --shadow: var(--shadow-md);
  --shadow-soft: var(--shadow-sm);
}

/* ========== Base Layout ========== */
* { box-sizing: border-box; }
html {
  scrollbar-gutter: stable;
  overflow-y: scroll;
}
/* ========== Dashboard Home Mode ========== */
html:has(body.dashboard-home-mode) {
  width: 100%;
  overflow: hidden;
  scrollbar-gutter: auto;
}
body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 12% 4%, rgba(255, 255, 255, 0.92), transparent 32rem),
    radial-gradient(ellipse at 86% 8%, rgba(244, 231, 205, 0.32), transparent 30rem),
    linear-gradient(178deg, #FFFDF8 0%, #FBF6ED 54%, #F5ECDD 100%);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  line-height: 1.5;
}
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
.app { width: min(1500px, calc(100% - 48px)); margin: 0 auto; padding: 20px 0 40px; }
.dashboard-home-mode {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}
.dashboard-home-mode .app {
  width: 100vw;
  height: 100vh;
  margin: 0;
  padding: 0;
  overflow: hidden;
}
.dashboard-home-mode main,
.dashboard-home-mode #dashboard {
  height: 100%;
  min-height: 0;
  overflow: hidden;
}
.dashboard-home-mode footer { display: none; }
/* ========== Header / Tabs / Views ========== */
.app-header {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
  padding: 12px 16px;
  border: 1px solid var(--champagne-line);
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, rgba(255,253,248,.88) 0%, rgba(250,244,232,.72) 100%);
  box-shadow: var(--shadow-md);
  backdrop-filter: blur(18px) saturate(1.15);
}
.brand-title { text-align: center; width: 100%; }
h1 { margin: 0; color: var(--text); font-size: clamp(1.45rem, 2.4vw, 2.05rem); font-weight: 800; }
h2 { margin: 0; color: var(--text); }
.subtitle, .section-title p, .asset-pie-card p { color: var(--muted); }
.subtitle { display: inline; margin-left: 12px; font-size: .78rem; font-weight: 400; color: var(--muted); vertical-align: middle; letter-spacing: .02em; }
.today-widget {
  display: grid; align-items: center; justify-items: start; gap: 6px; padding: 8px 12px; border: 1px solid var(--champagne-line); border-radius: var(--radius-md); background: var(--paper-glass); width: fit-content; justify-self: start; backdrop-filter: blur(14px);
}
.today-date-picker { position: relative; display: inline-flex; align-items: center; gap: 8px; min-height: 28px; padding-right: 2px; cursor: pointer; }
.today-date-picker input[type="date"] { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; min-height: 0; padding: 0; border: 0; opacity: 0; cursor: pointer; }
.today-date-picker input[type="month"] { display: none; }
.today-line { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: .82rem; font-weight: 600; }
.today-line + .today-line { gap: 8px; }
.today-line strong { color: var(--text); font-size: 1rem; font-weight: 700; }
.today-emoji { font-size: 1.2rem; line-height: 1; }
.header-quick-actions { display: inline-flex; gap: 7px; padding-top: 0; }
.header-quick-btn { width: 30px; height: 30px; min-height: 30px; padding: 0; border: 1px solid var(--champagne-line); border-radius: var(--radius-pill); background: rgba(255,253,248,.74); color: var(--primary-dark); font-size: .78rem; font-weight: 800; line-height: 1; box-shadow: var(--shadow-xs); }
.header-quick-btn:hover { background: rgba(243,230,206,.78); border-color: rgba(201,166,107,.62); color: var(--text); }
.month-picker { justify-self: end; min-width: 0; display: inline-flex; align-items: center; justify-content: flex-end; gap: 7px; }
.month-picker-inner { position: relative; grid-column: 1; grid-row: 1; min-height: 42px; min-width: 0; max-width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 8px 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: rgba(255,254,250,.78); overflow: hidden; }
.month-picker label { color: var(--muted); font-size: .72rem; font-weight: 700; white-space: nowrap; }
.month-display { color: var(--text); font-size: .9rem; font-weight: 700; white-space: nowrap; }
.month-picker input { position: absolute; inset: 0; min-width: 0; width: 100%; height: 100%; border: 0; outline: 0; opacity: 0; cursor: pointer; }
.top-backup-btn { width: 30px; height: 30px; min-height: 30px; padding: 0; border-radius: var(--radius-pill); border: 1px solid var(--champagne-line); background: rgba(255, 253, 248, .74); color: var(--primary-dark); font-size: .78rem; font-weight: 800; line-height: 1; }
.top-backup-btn:hover { background: rgba(243,230,206,.78); color: var(--text); }
.save-status {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 0 10px;
  border: 1px solid var(--champagne-line);
  border-radius: var(--radius-pill);
  background: rgba(255, 253, 248, 0.74);
  color: var(--muted);
  font-size: .74rem;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}
.hidden-view { display: none !important; }
.tabs { position: relative; z-index: 1; display: flex; justify-content: space-between; gap: 2px; overflow-x: auto; margin-bottom: 16px; padding: 4px; border: 1px solid var(--champagne-line); border-radius: var(--radius-pill); background: rgba(255,253,248,.72); box-shadow: var(--shadow-sm); scrollbar-width: none; backdrop-filter: blur(18px) saturate(1.08); }
/* ========== Dashboard Home Mode ========== */
.dashboard-home-mode .app-header,
.dashboard-home-mode .tabs { display: none; }
.module-page-mode .app-header,
.module-page-mode .tabs { display: none; }
.tabs::-webkit-scrollbar { height: 0; }
.tab { flex: 1 1 0; min-height: 40px; border: 0; border-radius: var(--radius-pill); background: rgba(255,254,250,.34); color: var(--muted); padding: 8px 16px; font-weight: 700; text-align: center; white-space: nowrap; transition: background .2s, color .2s, box-shadow .2s; }
.tab.active { background: linear-gradient(135deg, #2A2824, #494238); color: var(--surface); box-shadow: 0 8px 22px rgba(112,84,42,.16), inset 0 0 0 1px rgba(213,177,111,.38); }
.tab:hover:not(.active) { background: rgba(243,230,206,.54); color: var(--primary-dark); }
.view { display: none; }
.view.active { display: block; }

/* ========== Module Page Shell ========== */
.module-page-header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 14px;
  margin: 0 0 18px;
  padding: 14px 18px;
  border: 1px solid var(--champagne-line);
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, rgba(255,253,248,.94), rgba(248,241,229,.82));
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(18px) saturate(1.08);
}
.module-page-header > div { min-width: 0; }
.module-page-header span {
  display: block;
  color: var(--primary-dark);
  font-size: .76rem;
  font-weight: 800;
}
.module-page-header h2 {
  margin-top: 2px;
  font-size: 1.34rem;
}
.module-page-header p {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: .86rem;
}
.module-back-btn {
  width: 42px;
  height: 42px;
  display: inline-grid;
  place-items: center;
  border: 1px solid var(--champagne-line);
  border-radius: var(--radius-pill);
  background: rgba(255,253,248,.78);
  color: var(--primary-dark);
  font-size: 1.8rem;
  line-height: 1;
  box-shadow: var(--shadow-xs);
}
.module-back-btn:hover {
  background: rgba(243,230,206,.74);
  color: var(--text);
}
.dashboard-home-mode .module-page-header { display: none; }
</file>

