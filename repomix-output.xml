.action-feedback.open { transform: translate(-50%, 0); opacity: 1; pointer-events: auto; }
.action-feedback > span { min-width: 0; overflow-wrap: anywhere; font-size: .88rem; font-weight: 650; }
.action-feedback button { min-height: 34px; border: 0; border-radius: 8px; background: rgba(229,195,128,.18); color: #f2d59a; padding: 6px 11px; font-weight: 750; }
.action-feedback button:hover { background: rgba(229,195,128,.28); }
.action-feedback .action-feedback-close { width: 34px; padding: 0; background: transparent; color: rgba(255,255,255,.66); font-size: 1.1rem; }

.module-page-mode .empty-card {
