.module-page-mode .record-card:hover .row-actions,
.module-page-mode .record-card:focus-within .row-actions { opacity: 1; }

.action-feedback {
  position: fixed;
  z-index: 120;
  left: 50%;
  bottom: max(20px, env(safe-area-inset-bottom));
  width: min(560px, calc(100% - 24px));
  min-height: 52px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto 34px;
  align-items: center;
  gap: 10px;
  padding: 9px 10px 9px 16px;
  border: 1px solid rgba(215,184,126,.48);
  border-radius: 14px;
  background: rgba(35,34,31,.96);
  color: #fffdf8;
  box-shadow: 0 18px 46px rgba(29,29,31,.24);
