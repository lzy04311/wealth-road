  font-size: 12px;
  font-weight: 500;
  line-height: 1.3;
}

.dashboard-trend-facts strong {
  margin-top: 2px;
  color: var(--text);
  font-family: var(--font-number);
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -.02em;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

.dashboard-center-panel {
  min-width: 0;
  display: grid;
  place-items: center;
  position: relative;
  z-index: 2;
  isolation: isolate;
  overflow: visible;
}

.dashboard-asset-card,
.dashboard-right-cards {
  position: relative;
  z-index: 3;
}

.dashboard-center-panel::before,
.dashboard-center-panel::after {
  content: "";
  position: absolute;
  pointer-events: none;
}

.dashboard-center-panel::before {
  inset: 6% 0;
  background:
    radial-gradient(ellipse at 50% 50%, rgba(219,183,112,.13), transparent 22rem),
    linear-gradient(28deg, transparent 0 39%, rgba(201,166,107,.078) 39.15% 39.32%, transparent 39.56%),
    linear-gradient(152deg, transparent 0 39%, rgba(201,166,107,.070) 39.15% 39.32%, transparent 39.56%);
  opacity: .58;
}

.dashboard-center-panel::after {
  z-index: 0;
  left: 50%;
  top: 50%;
  width: min(70%, 500px, calc(100% - 120px));
  max-height: calc(100% - 96px);
  aspect-ratio: 1 / 1;
  transform: translate(-50%, -50%);
  border-radius: 999px;
  background:
    radial-gradient(circle, transparent 0 42%, rgba(223,195,144,.080) 42.2% 42.45%, transparent 42.75%),
    radial-gradient(circle, transparent 0 50%, rgba(223,195,144,.052) 50.2% 50.42%, transparent 50.72%),
    radial-gradient(circle, transparent 0 59%, rgba(223,195,144,.038) 59.15% 59.34%, transparent 59.64%);
  opacity: .76;
}

.dashboard-center-orbit {
  position: relative;
  z-index: 1;
  width: min(100%, 690px);
  min-height: 510px;
  transform: translateY(calc(var(--dashboard-core-lift) * -1));
  border-radius: 36px;
  overflow: visible;
  background: none;
}

.wealth-core-visual {
  position: absolute;
  left: 50%;
  top: 50%;
  width: min(108%, 760px);
  max-width: calc(100% + 56px);
  height: auto;
  transform: translate(-50%, -50%);
  pointer-events: none;
  overflow: visible;
}

.wealth-core-back {
  z-index: 0;
}

.wealth-core-front {
  z-index: 2;
  opacity: .94;
}

.wealth-core-field {
  fill: url(#wealthHeroGlow);
  filter: url(#wealthSoftBlur);
  opacity: 0;
}

.wealth-sphere {
  display: none;
}

.wealth-sphere-inner {
  display: none;
}

.wealth-sphere-shade {
  display: none;
}

.wealth-highlight {
  fill: none;
  stroke: url(#wealthGlassArc);
  stroke-width: 5.2;
  stroke-linecap: round;
  opacity: 0;
  filter: blur(.06px);
}

.wealth-highlight.second {
  display: none;
}

.wealth-highlight.small {
  display: none;
}

.wealth-track {
  fill: none;
  stroke: rgba(238,215,174,.086);
  stroke-width: .44;
  stroke-dasharray: 180 34 42 24;
  transform-box: fill-box;
  transform-origin: center;
  animation: none;
  opacity: 0;
}

.wealth-track.track-a {
  display: none;
}

.wealth-track.track-b {
  display: none;
}

.wealth-track.track-c {
  display: none;
}

.wealth-track.track-front {
  display: none;
}

.wealth-flow {
  fill: none;
  stroke: url(#wealthArcGold);
  stroke-width: .48;
  stroke-linecap: round;
  stroke-dasharray: 260 42;
  opacity: 0;
  display: none;
}

.wealth-flow.flow-back-b {
  display: none;
}

.wealth-flow.flow-front-a {
  display: none;
}

.wealth-flow.flow-front-b {
  display: none;
}

.wealth-particles circle {
  fill: rgba(255,226,168,.95);
  filter: url(#wealthPearlGlow);
  opacity: 0;
  animation: none;
}

.wealth-pearl {
  fill: #EEC27A;
  stroke: rgba(255,255,255,.94);
  stroke-width: 1.18;
  filter: url(#wealthPearlGlow);
  opacity: 0;
  animation: none;
}

.wealth-pearl.pearl-b,
.wealth-pearl.pearl-d {
  animation-duration: 12s;
}

.wealth-pearl.pearl-c {
  animation-duration: 14s;
}

.dashboard-center-orbit::before,
.dashboard-center-orbit::after,
.compass-node-layer::before,
.compass-node-layer::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border-radius: 999px;
  pointer-events: none;
}

.dashboard-center-orbit::before {
  display: none;
}

.dashboard-center-orbit::after {
  display: none;
}

.compass-node-layer::before {
  display: none;
}

.compass-node-layer::after {
  display: none;
}

.compass-core {
  position: absolute;
  left: 50%;
  top: calc(50% + 20px);
  z-index: 3;
  width: clamp(250px, 28vw, 330px);
  height: clamp(250px, 28vw, 330px);
  transform: translate(-50%, -50%);
  display: grid;
  place-items: center;
  align-content: center;
  gap: 5px;
  border-radius: 999px;
  border: 1px solid rgba(235,210,164,.10);
  background:
    radial-gradient(ellipse at 34% 16%, rgba(255,255,255,.86) 0%, rgba(255,255,255,.54) 24%, rgba(255,253,247,.18) 42%, rgba(255,253,247,0) 62%),
    radial-gradient(ellipse at 60% 76%, rgba(171,123,54,.05) 0%, rgba(171,123,54,.02) 30%, rgba(171,123,54,0) 64%),
    radial-gradient(ellipse at 50% 52%, rgba(255,250,239,.68) 0%, rgba(248,237,213,.36) 52%, rgba(233,202,145,.14) 100%);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.64),
    inset 14px 14px 30px rgba(255,255,255,.22),
    inset -10px -14px 22px rgba(145,94,31,.03),
    inset 0 0 18px rgba(255,250,236,.14);
  transition: box-shadow .18s ease, transform .18s ease;
  animation: wealthCoreBreath 9.5s ease-in-out infinite;
}

.compass-core::before,
.compass-core::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
}

.compass-core::before {
  display: none;
}

.compass-core::after {
  inset: 10% 16% auto;
  height: 30%;
  border-radius: 999px 999px 48% 48%;
  background: radial-gradient(ellipse at 50% 30%, rgba(255,255,255,.52) 0%, rgba(255,255,255,.24) 46%, rgba(255,255,255,0) 100%);
  opacity: .42;
  filter: blur(.25px);
  animation: compassGlassBreath 10s ease-in-out infinite;
}

.compass-core:hover {
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.9),
    inset -20px -22px 42px rgba(201,166,107,.058);
}

.core-kicker {
  position: relative;
  color: var(--muted);
  font-family: var(--font-serif-zh);
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .01em;
  display: none;
}

.compass-core strong {
  color: transparent;
  position: relative;
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(255,249,226,.44) 0%, rgba(255,246,218,0) 22%),
    linear-gradient(95deg, rgba(255,238,190,0) 0 33%, rgba(255,238,190,.40) 47%, rgba(255,238,190,0) 61%),
    linear-gradient(180deg, #AD6B20 0%, #DDA746 28%, #F4CC79 48%, #B47326 73%, #74410F 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  font-family: var(--font-serif-zh);
  font-size: clamp(7.4rem, 10.2vw, 9.9rem);
  line-height: 1;
  font-weight: 700;
  letter-spacing: -.02em;
  filter: drop-shadow(0 0 8px rgba(238,196,112,.18));
  text-shadow:
    0 1px 0 rgba(255,247,220,.34),
    0 2px 4px rgba(95,59,18,.11),
    0 0 10px rgba(224,180,92,.14),
    0 0 20px rgba(244,216,154,.16);
}

.compass-core span:last-child {
  position: relative;
  z-index: 1;
  max-width: 190px;
  color: var(--muted);
  font-family: var(--font-sans-zh);
  font-size: .84rem;
  font-weight: 500;
  line-height: 1.45;
  text-align: center;
  display: none;
}

@keyframes compassGlassBreath {
  0%, 100% { opacity: .30; transform: translateY(0) scale(1); }
  50% { opacity: .46; transform: translateY(-2px) scale(1.015); }
}

@keyframes wealthCoreBreath {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  50% { transform: translate(-50%, -50%) scale(1.012); }
}

@keyframes wealthTrackDrift {
  0% { stroke-dashoffset: 0; }
  100% { stroke-dashoffset: 320; }
}

@keyframes wealthGlowPulse {
  0%, 100% { opacity: .82; }
  50% { opacity: 1; }
}

@keyframes wealthPearlDrift {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-1.8px); }
}

.compass-node-layer {
  position: absolute;
  inset: 0;
  z-index: 4;
  transform: translateY(4px);
}

.compass-node {
  position: absolute;
  left: var(--x);
  top: var(--y);
  width: 96px;
  min-height: 96px;
  transform: translate(-50%, -50%);
  display: grid;
  grid-template-columns: 1fr;
  grid-template-areas:
    "name"
    "value"
    "desc";
  align-content: center;
  justify-items: start;
  text-align: center;
  border: 1px solid rgba(201,166,107,.18);
  border-radius: 999px;
  padding: 23px 12px 12px;
  background:
    radial-gradient(circle at 22% 14%, rgba(255,255,255,.56), transparent 46%),
    rgba(255,253,248,.46);
  box-shadow: 0 6px 14px rgba(133,100,52,.028), inset 0 1px 0 rgba(255,255,255,.52);
  backdrop-filter: blur(15px) saturate(1.04);
  -webkit-backdrop-filter: blur(15px) saturate(1.04);
  transition: transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease;
}

.compass-node::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: var(--link-w, 86px);
  height: 1px;
  transform-origin: left center;
  transform: rotate(var(--link-r, 0deg));
  background: none;
  pointer-events: none;
  z-index: -1;
}

.compass-node:hover {
  border-color: rgba(201,166,107,.58);
  background:
    radial-gradient(circle at 22% 14%, rgba(255,255,255,.76), transparent 46%),
    rgba(255,253,248,.80);
  transform: translate(-50%, calc(-50% - 3px));
  box-shadow: 0 9px 20px rgba(133,100,52,.075), inset 0 1px 0 rgba(255,255,255,.70);
}

.node-dot {
  grid-area: dot;
  position: absolute;
  left: 50%;
  top: -10px;
  transform: translateX(-50%);
  width: 27px;
  height: 27px;
  border-radius: 999px;
  border: 1px solid rgba(201,166,107,.24);
  background:
    radial-gradient(circle at 35% 28%, rgba(255,255,255,.86), transparent 44%),
    rgba(255,253,248,.82);
  box-shadow: 0 4px 9px rgba(133,100,52,.035), inset 0 1px 0 rgba(255,255,255,.68);
}

.node-dot::before {
  content: "";
  position: absolute;
  inset: 9px;
  border-radius: inherit;
  background: #9F7338;
  box-shadow: 0 0 0 4px rgba(201,166,107,.08), 0 0 10px rgba(201,166,107,.12);
}

.node-name {
  grid-area: name;
  color: var(--text);
  justify-self: center;
  font-family: var(--font-sans-zh);
  font-size: .75rem;
  font-weight: 650;
  line-height: 1.18;
  letter-spacing: 0;
}

.node-desc {
  grid-area: desc;
  justify-self: center;
  color: var(--muted);
  font-family: var(--font-sans-zh);
  font-size: .61rem;
  font-weight: 500;
  line-height: 1.28;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.compass-node strong {
  grid-area: value;
  justify-self: center;
  margin-top: 4px;
  margin-bottom: 2px;
  color: #8E6A32;
  font-family: var(--font-number);
  font-size: .70rem;
  line-height: 1.05;
  font-weight: 700;
  letter-spacing: -.02em;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.node-data { --x: 16%; --y: 20%; --link-r: 28deg; --link-w: 124px; }
.node-flow { --x: 10%; --y: 54%; --link-r: 0deg; --link-w: 138px; }
.node-goals { --x: 16%; --y: 88%; --link-r: -28deg; --link-w: 124px; }
.node-invest { --x: 84%; --y: 20%; --link-r: 152deg; --link-w: 124px; }
.node-assets { --x: 90%; --y: 54%; --link-r: 180deg; --link-w: 138px; }
.node-accounts { --x: 84%; --y: 88%; --link-r: -152deg; --link-w: 124px; }

.dashboard-right-cards {
  min-width: 0;
  margin-right: 30px;
  align-self: start;
  height: calc(100% - var(--dashboard-core-lift));
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
