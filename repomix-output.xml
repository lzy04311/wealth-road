  font-weight: 850;
}

.dashboard-mini-sparkline {
  height: 34px;
  align-self: end;
  border-radius: 12px;
  background:
    linear-gradient(180deg, rgba(255,255,255,.20), rgba(255,253,248,.02)),
    linear-gradient(90deg, rgba(201,166,107,.08), rgba(255,253,248,.22));
