  overflow: hidden;
}

.dashboard-strip-invest .dashboard-strip-visual {
  display: grid;
  justify-items: stretch;
  width: 100%;
}

.dashboard-strip-sparkline svg {
  width: 100%;
  height: 100%;
  display: block;
}

.dashboard-strip-sparkline .strip-sparkline-guides line {
  stroke: rgba(201,166,107,.16);
